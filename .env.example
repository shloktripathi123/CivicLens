# Optional: these enable additional federal and state data.
CONGRESS_API_KEY=
OPENSTATES_API_KEY=
# Optional absolute path; defaults to the repository's data/civic.db.
# DB_PATH=/absolute/path/to/civic.db

# Free key from https://api.data.gov/signup/ (without it, FEC ingest is rate-limited and capped).
FEC_API_KEY=

# Optional even election year override for FEC data; defaults to the next federal cycle.
# ELECTION_CYCLE=2028
